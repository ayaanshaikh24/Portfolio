<svg xmlns="http://www.w3.org/2000/svg" width="800" height="480" viewBox="0 0 800 480">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e1b4b" />
      <stop offset="100%" stop-color="#090d16" />
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>
  </defs>
  <rect width="800" height="480" fill="url(#bg)" />
  
  <!-- Browser Header bar mockup -->
  <rect x="50" y="40" width="700" height="40" rx="8" fill="#1e293b" />
  <circle cx="75" cy="60" r="5" fill="#ef4444" />
  <circle cx="95" cy="60" r="5" fill="#eab308" />
  <circle cx="115" cy="60" r="5" fill="#22c55e" />
  <rect x="140" y="48" width="400" height="24" rx="6" fill="#0f172a" />
  <text x="160" y="64" font-family="monospace" font-size="11" fill="#94a3b8">https://pricewise-ai.dev/dashboard</text>
  
  <!-- Dashboard UI layout mockup -->
  <rect x="50" y="90" width="700" height="350" rx="8" fill="#0b0f19" stroke="#334155" stroke-width="1" />
  
  <!-- Sidebar -->
  <rect x="65" y="105" width="130" height="320" rx="6" fill="#111827" />
  <rect x="80" y="125" width="100" height="18" rx="4" fill="#6366f1" opacity="0.6" />
  <rect x="80" y="155" width="80" height="12" rx="4" fill="#334155" />
  <rect x="80" y="180" width="90" height="12" rx="4" fill="#334155" />
  <rect x="80" y="205" width="70" height="12" rx="4" fill="#334155" />
  
  <!-- Content cards -->
  <rect x="210" y="105" width="525" height="70" rx="6" fill="#1e293b" />
  <text x="230" y="135" font-family="sans-serif" font-weight="bold" font-size="18" fill="#ffffff">PriceWiseAI • Smart Shopping Engine</text>
  <text x="230" y="158" font-family="sans-serif" font-size="12" fill="#38bdf8">Real-time Web Scraper & Product Analytics</text>
  
  <rect x="210" y="190" width="250" height="235" rx="6" fill="#111827" stroke="#1f293d" />
  <path d="M 230 380 Q 280 260, 330 320 T 430 230" fill="none" stroke="url(#glow)" stroke-width="4" />
  <text x="230" y="215" font-family="sans-serif" font-weight="bold" font-size="13" fill="#cbd5e1">Price Trend Tracker</text>
  
  <rect x="475" y="190" width="260" height="235" rx="6" fill="#111827" stroke="#1f293d" />
  <text x="495" y="215" font-family="sans-serif" font-weight="bold" font-size="13" fill="#cbd5e1">Competitor Comparison API</text>
  <rect x="495" y="240" width="220" height="40" rx="4" fill="#1e293b" />
  <rect x="495" y="290" width="220" height="40" rx="4" fill="#1e293b" />
  <rect x="495" y="340" width="220" height="40" rx="4" fill="#1e293b" />
</svg>
